# Firebase Authentication Configuration
# Replace these with your Firebase project credentials from https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API URL (only needed when frontend is deployed separately on Vercel)
# Set this to your Render backend URL, e.g: https://agriprice-tracker.onrender.com
# Leave empty when running locally or when backend serves the frontend (Render full-stack)
VITE_API_URL=
